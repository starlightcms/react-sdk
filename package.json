{
  "name": "@starlightcms/react-sdk",
  "version": "4.2.0-beta.2",
  "description": "The Starlight SDK for React",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "docs": "npm start -w website",
    "docs:build": "npm run build -w website",
    "docs:serve": "npm run serve -w website",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starlightcms/react-sdk.git"
  },
  "keywords": [
    "starlight",
    "sdk"
  ],
  "author": "Lucas Varela <hi@lucasvarela.dev>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/starlightcms/react-sdk/issues"
  },
  "homepage": "https://github.com/starlightcms/react-sdk#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.10.3",
    "@types/react": "^18.3.27",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^7.0.2",
    "lint-staged": "^11.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "rimraf": "^3.0.2",
    "sass": "^1.69.5",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@starlightcms/js-sdk": "^4.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
